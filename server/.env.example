PORT=3000

# Supabase project URL (Settings -> API)
SUPABASE_URL=https://mvvhdyaawrtdbyjiobau.supabase.co

# Public anon key - safe to expose to browsers, used here only server-side
# for the "public" client (RLS-restricted reads on behalf of anonymous users).
SUPABASE_ANON_KEY=your-anon-key

# Service-role key - NEVER expose to the browser. Bypasses RLS. Only used
# after requireAuth/requireAdmin middleware has verified the caller.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email that gets auto-promoted to role='admin' on first signup matching it.
# On every boot, server.js upserts this into the app_settings row
# ('initial_admin_email') that the handle_new_user() trigger reads from -
# it can't be passed as a per-connection setting because signup happens via
# Supabase Auth directly, never through this server.
SUPABASE_INITIAL_ADMIN_EMAIL=admin@thanhhau.vn

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
